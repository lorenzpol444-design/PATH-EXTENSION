{
  "manifest_version": 3,
  "name": "Path AI",
  "version": "5.0.1",
  "description": "An AI sidebar assistant with browser control.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus", "tabs", "downloads", "windows", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["sidebar.css"],
      "run_at": "document_idle"
    }
  ]
}